# AI Podcast Generator Environment Variables Template
# Copy this file to '.env' and fill in your credentials

# Port to run the server on
PORT=5000

# API Keys
GROQ_API_KEY=your_groq_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# MongoDB Connection String (leave blank or comment out to use in-memory storage)
MONGO_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/your_db

# Secret Keys for Flask & JWT Authentication
# Run 'python generate_keys.py' to generate secure values for these
JWT_SECRET=your_jwt_secret_here
FLASK_SECRET_KEY=your_flask_secret_key_here
